# ==============================================================================
# Local Enterprise RAG Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-documents

# Event Bus (Redpanda / Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
TOPIC_REALTIME=doc-ingest-realtime
TOPIC_BULK=doc-ingest-bulk
TOPIC_DLQ=doc-ingest-dlq
CONSUMER_GROUP=rag-parser-group

# Document Metadata Store (MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=rag_metadata

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# Local LLM Serving (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b

# Retrieval & Reranker Settings
DEFAULT_TOP_K_CANDIDATES=50
DEFAULT_RERANK_TOP_N=5
EMBEDDING_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
